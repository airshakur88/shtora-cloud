		{
			"id": "php-redirect-001",
			"regex": "header\\s*\\(\\s*['\"]Location:\\s*['\"]\\s*\\.[^;\\n]*\\$_(?:GET|POST|REQUEST)",
			"vuln_type": "open_redirect",
			"confidence": "likely",
			"description": "Location header is built from request data"
		},
		{
			"id": "php-redirect-framework-001",
			"regex": "(?:redirect|new\\s+RedirectResponse|wp_redirect)\\s*\\([^;\\n]*(?:\\$_(?:GET|POST|REQUEST)|request\\s*\\(|\\$request\\s*->)",
			"vuln_type": "open_redirect",
			"confidence": "likely",
			"description": "Framework redirect destination is request-controlled"
		}
	],
	"mass_assignment": [
		{
			"id": "php-mass-laravel-001",
			"regex": "(?:[A-Z][A-Za-z0-9_]*::create|->(?:fill|forceFill|update))\\s*\\(\\s*(?:request\\s*\\(\\s*\\)\\s*->\\s*all\\s*\\(\\s*\\)|\\$request\\s*->\\s*all\\s*\\(\\s*\\))",
			"vuln_type": "mass_assignment",
			"confidence": "likely",
			"description": "Laravel model mutation consumes the complete request map"
		},
		{
			"id": "php-mass-symfony-001",
			"regex": "->deserialize\\s*\\([^;\\n]*\\$request\\s*->getContent\\s*\\([^;\\n]*[A-Z][A-Za-z0-9_]*::class",
			"vuln_type": "mass_assignment",
			"confidence": "possible",
			"description": "Symfony serializer writes a request body directly into an object; verify writable privileged fields"
		}
	],
	"authorization": [
		{
			"id": "php-auth-wp-001",
			"regex": "['\"]permission_callback['\"]\\s*=>\\s*['\"]__return_true['\"]",
			"vuln_type": "missing_authorization",
			"confidence": "possible",
			"description": "WordPress REST route is explicitly public; verify the route exposes no privileged data or action"
		}
	],
	"sensitive_logging": [
		{
			"id": "php-log-001",
			"regex": "(?:Log::(?:debug|info|notice|warning|error)|->(?:debug|info|notice|warning|error))\\s*\\([^;\\n]*(?:\\$request\\s*->\\s*all\\s*\\(|\\$request\\s*->getContent\\s*\\(|\\$_(?:POST|REQUEST|COOKIE|FILES))",
			"vuln_type": "sensitive_data_exposure",
			"confidence": "possible",
			"description": "Application logging records an unfiltered request body, cookie, or upload map"
