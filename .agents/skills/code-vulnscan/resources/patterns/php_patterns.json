			"regex": "error_log\\s*\\([^;\\n]*\\$_SERVER\\s*\\[\\s*['\"]HTTP_AUTHORIZATION['\"]",
			"vuln_type": "sensitive_data_exposure",
			"confidence": "likely",
			"description": "Authorization credentials are written to the error log"
		}
	],
	"crypto_tls": [
		{
			"id": "php-crypto-password-001",
			"regex": "(?:md5|sha1)\\s*\\(\\s*\\$_(?:POST|REQUEST)\\s*\\[[^]]*(?:password|passwd|secret)",
			"vuln_type": "weak_crypto",
