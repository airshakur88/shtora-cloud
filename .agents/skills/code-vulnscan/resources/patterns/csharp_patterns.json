{
  "sqli": [
    {
      "id": "cs-sqli-command-interpolation",
      "regex": "new\\s+(?:Sql|Npgsql|MySql|OleDb|Odbc)Command\\s*\\(\\s*\\$@?[\\\"]",
      "vuln_type": "sqli",
      "confidence": "likely",
      "description": "ADO.NET command text is built with string interpolation"
    },
    {
      "id": "cs-sqli-command-concatenation",
      "regex": "new\\s+(?:Sql|Npgsql|MySql|OleDb|Odbc)Command\\s*\\([^;]*(?:SELECT|INSERT|UPDATE|DELETE)[^;]*\\+\\s*[A-Za-z_$]",
      "vuln_type": "sqli",
      "confidence": "likely",
      "description": "ADO.NET command text is built with string concatenation"
    },
    {
      "id": "cs-sqli-ef-raw-interpolation",
      "regex": "\\.(?:FromSqlRaw|ExecuteSqlRaw(?:Async)?|SqlQueryRaw)\\s*\\(\\s*\\$@?[\\\"]",
      "vuln_type": "sqli",
      "confidence": "likely",
      "description": "EF Core raw SQL API receives an interpolated string; use an interpolated API or bound parameters"
    },
    {
      "id": "cs-sqli-dapper-interpolation",
      "regex": "\\.(?:Query|QueryAsync|QueryFirst|QueryFirstAsync|QuerySingle|QuerySingleAsync|Execute|ExecuteAsync)(?:\\s*<[^>]+>)?\\s*\\(\\s*\\$@?[\\\"]",
      "vuln_type": "sqli",
      "confidence": "likely",
      "description": "Dapper SQL is built with string interpolation instead of a parameter object"
    },
    {
      "id": "cs-sqli-commandtext-interpolation",
      "regex": "\\.CommandText\\s*=\\s*\\$@?[\\\"]",
      "vuln_type": "sqli",
      "confidence": "likely",
      "description": "ADO.NET CommandText is assigned interpolated SQL"
    }
  ],
