		},
		{
			"id": "rb-ssrf-002",
			"regex": "(?:RestClient|HTTParty|HTTP)\\.(?:get|post|put|patch|delete|request)\\s*\\([^;\\n]*params(?:\\[|\\.)",
			"vuln_type": "ssrf",
			"confidence": "likely",
			"description": "Third-party HTTP client receives a request-controlled URL"
		},
		{
			"id": "rb-ssrf-faraday-001",
			"regex": "Faraday\\.(?:get|post|put|patch|delete)\\s*\\([^;\\n]*params(?:\\[|\\.)",
			"vuln_type": "ssrf",
			"confidence": "likely",
			"description": "Faraday request target comes directly from request parameters"
		}
	],
	"open_redirect": [
		{
			"id": "rb-redirect-rails-001",
			"regex": "redirect_to\\s*(?:\\(|\\s)\\s*params(?:\\[|\\.)",
			"vuln_type": "open_redirect",
			"confidence": "likely",
			"description": "Rails redirect destination is request-controlled"
		},
		{
			"id": "rb-redirect-sinatra-001",
			"regex": "(?<!redirect_to\\s)\\bredirect\\s*(?:\\(|\\s)\\s*params(?:\\[|\\.)",
			"vuln_type": "open_redirect",
			"confidence": "likely",
			"description": "Sinatra redirect destination is request-controlled"
		}
	],
	"authorization": [
		{
			"id": "rb-tenant-001",
			"regex": "\\.unscoped\\.(?:find|find_by)\\s*\\([^;\\n]*params(?:\\[|\\.)",
			"vuln_type": "tenant_scope_bypass",
			"confidence": "possible",
			"description": "Unscoped lookup uses a request identifier; verify explicit object and tenant authorization"
		}
	],
	"sensitive_logging": [
		{
			"id": "rb-log-001",
			"regex": "(?:Rails\\.logger|logger)\\.(?:debug|info|warn|error|fatal)\\s*(?:\\(|\\s)[^;\\n]*params(?:\\.to_unsafe_h|\\b)",
			"vuln_type": "sensitive_data_exposure",
			"confidence": "possible",
			"description": "Application log records an unfiltered parameter map"
		},
		{
			"id": "rb-log-auth-001",
			"regex": "(?:Rails\\.logger|logger)\\.(?:debug|info|warn|error|fatal)[^;\\n]*(?:HTTP_AUTHORIZATION|Authorization)[^;\\n]*(?:request\\.headers|request\\.env)",
			"vuln_type": "sensitive_data_exposure",
			"confidence": "likely",
			"description": "Authorization credentials are written to application logs"
		}
	],
	"crypto_tls": [
		{
			"id": "rb-crypto-password-001",
			"regex": "Digest::(?:MD5|SHA1)\\.hexdigest\\s*\\([^;\\n]*params\\s*\\[[^]]*(?:password|passwd|secret)",
			"vuln_type": "weak_crypto",
			"confidence": "confirmed",
			"description": "A submitted password or secret is hashed directly with MD5 or SHA-1"
		},
		{
			"id": "rb-tls-001",
			"regex": "verify_mode\\s*=\\s*OpenSSL::SSL::VERIFY_NONE",
			"vuln_type": "tls_bypass",
			"confidence": "confirmed",
			"description": "TLS certificate verification is explicitly disabled"
		}
